# ============================================================================
# KONFIGURASI ENVIRONMENT VARIABLES LOGIFLOW (VERCEL & SUPABASE)
# Salin nilai-nilai ini ke menu Environment Variables di Dashboard Vercel
# ============================================================================

# 1. DATABASE POSTGRESQL SUPABASE (Dari menu Project Settings -> Database)
# Gunakan port 6543 (Transaction connection pooler) untuk DATABASE_URL di Vercel Serverless
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Gunakan port 5432 (Direct connection) untuk Prisma migration & db push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. SUPABASE STORAGE (Untuk Upload & Simpan Foto Bukti Presensi Permanen)
# Dari menu Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
