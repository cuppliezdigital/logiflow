// ============================================================================
// KONFIGURASI DATABASE LOGIFLOW
// Menggunakan database PostgreSQL (Supabase) dan Prisma ORM Client
// Mendukung connection pooling (port 6543) dan direct connection (port 5432)
// ============================================================================
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------------
// 1. MODEL VENDOR (Penyedia Tenaga Kerja / Outsourcing)
// Menyimpan informasi perusahaan penyalur buruh harian / pekerja lepas.
// Dapat dikelola (tambah/edit/hapus) langsung dari UI aplikasi.
// ----------------------------------------------------------------------------
model Vendor {
  id         String      @id @default(cuid())
  name       String      // Nama perusahaan vendor (misal: PT BAL Logistik Internasional)
  picName    String?     // Nama kontak person (PIC) dari vendor
  phone      String?     // Nomor telepon / WhatsApp PIC vendor
  status     String      @default("ACTIVE") // Status kemitraan: ACTIVE / INACTIVE
  createdAt  DateTime    @default(now())
  plotingans Plotingan[] // Relasi: Satu vendor bisa memiliki banyak jadwal plotingan
}

// ----------------------------------------------------------------------------
// 2. MODEL SHIFT (Shift Operasional Kerja: Pagi & Malam)
// Hanya ada 2 shift kerja: "Shift Pagi" dan "Shift Malam".
// Jam kerja tidak dipatok kaku (bersifat fleksibel per kebutuhan gudang).
// ----------------------------------------------------------------------------
model Shift {
  id               String            @id @default(cuid())
  name             String            // Nama shift ("Shift Pagi" atau "Shift Malam")
  startTime        String?           // Waktu mulai (opsional / fleksibel)
  endTime          String?           // Waktu selesai (opsional / fleksibel)
  createdAt        DateTime          @default(now())
  plotingans       Plotingan[]       // Relasi: Satu shift bisa diisi oleh banyak plotingan vendor
  underAssignments UnderAssignment[] // Relasi: Satu shift memiliki banyak penugasan under lapangan
}

// ----------------------------------------------------------------------------
// 3. MODEL PLOTINGAN (Target Kebutuhan Manpower / H-1 Planning)
// 1 Vendor pada 1 Shift hanya memiliki 1 baris Plotingan yang sudah langsung
// mencakup kuota REGULAR dan kuota ADDITIONAL (Lembur/Tambahan) sekaligus.
// ----------------------------------------------------------------------------
model Plotingan {
  id               String         @id @default(cuid())
  date             String         // Tanggal kerja format YYYY-MM-DD (misal: 2026-09-12)
  vendorId         String
  vendor           Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  shiftId          String
  shift            Shift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  targetRegular    Int            @default(0) // Kuota target tenaga kerja regular (rutin)
  targetAdditional Int            @default(0) // Kuota target tenaga kerja additional (lembur/peak)
  targetHeadcount  Int            // Total target kuota (targetRegular + targetAdditional)
  status           String?        @default("MIXED") // Kompatibilitas status
  workingHours     String?        // Jam kerja operasional (opsional/fleksibel, misal: "07:00 - 15:30" atau "Fleksibel")
  notes            String?        // Catatan khusus (misal: "Khusus area sortir inbound")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  attendanceIn     AttendanceIn?  // Relasi: 1 Plotingan memiliki 1 data Absen Masuk

  @@index([date])
}

// ----------------------------------------------------------------------------
// 4. MODEL ATTENDANCE IN (Absen Masuk / Serah Terima Pasukan di Awal Shift)
// Mendukung multi-foto per bagian gudang (Bongkar, Muat, Sortir, Repack, FIFO, dll)
// yang disimpan dalam format JSON array terstruktur.
// ----------------------------------------------------------------------------
model AttendanceIn {
  id                    String         @id @default(cuid())
  plotinganId           String         @unique
  plotingan             Plotingan      @relation(fields: [plotinganId], references: [id], onDelete: Cascade)
  checkInTime           DateTime       @default(now()) // Waktu serah terima absen masuk
  actualRegular         Int            @default(0)     // Jumlah fisik orang regular yang hadir
  actualAdditional      Int            @default(0)     // Jumlah fisik orang additional yang hadir
  actualHeadcount       Int            // Total orang masuk (actualRegular + actualAdditional)
  
  // Penyimpanan Multi-Foto per Bagian (JSON Array of { section: string, url: string })
  photosRegularJson     String?        // JSON list foto presensi barisan REGULAR per bagian
  photosAdditionalJson  String?        // JSON list foto presensi barisan ADDITIONAL per bagian
  
  // Fallback thumbnail tunggal
  photoInRegularUrl     String?        // Link URL foto thumbnail barisan REGULAR
  photoInAdditionalUrl  String?        // Link URL foto thumbnail barisan ADDITIONAL
  photoInUrl            String?        // Fallback kompatibilitas foto umum
  
  notes                 String?        // Catatan saat serah terima presensi masuk
  createdAt             DateTime       @default(now())
  attendanceOut         AttendanceOut? // Relasi: 1 Absen Masuk memiliki 1 data Absen Pulang
}

// ----------------------------------------------------------------------------
// 5. MODEL ATTENDANCE OUT (Absen Pulang, Tumbang & Audit Integritas)
// Mendukung multi-foto checkout kepulangan per bagian dan foto bukti klinik P3K.
// ----------------------------------------------------------------------------
model AttendanceOut {
  id                        String       @id @default(cuid())
  attendanceInId            String       @unique
  attendanceIn              AttendanceIn @relation(fields: [attendanceInId], references: [id], onDelete: Cascade)
  checkOutTime              DateTime     @default(now()) // Waktu checkout presensi selesai shift
  
  // Rincian Kepulangan Utuh
  pulangRegular             Int          @default(0)     // Jumlah orang regular yang pulang utuh
  pulangAdditional          Int          @default(0)     // Jumlah orang additional yang pulang utuh
  pulangHeadcount           Int          // Total orang pulang utuh (pulangRegular + pulangAdditional)
  
  // Rincian Orang Tumbang (Sakit / Cedera Kerja)
  tumbangRegular            Int          @default(0)     // Jumlah orang regular yang sakit/tumbang
  tumbangAdditional         Int          @default(0)     // Jumlah orang additional yang sakit/tumbang
  tumbangHeadcount          Int          @default(0)     // Total orang tumbang (tumbangRegular + tumbangAdditional)
  
  // Penyimpanan Multi-Foto Checkout per Bagian (JSON Array of { section: string, url: string })
  photosPulangRegularJson   String?      // JSON list foto checkout REGULAR per bagian
  photosPulangAdditionalJson String?     // JSON list foto checkout ADDITIONAL per bagian
  
  // Dokumentasi Foto Bukti & Fallback
  photoPulangRegularUrl     String?      // Thumbnail foto checkout REGULAR
  photoPulangAdditionalUrl  String?      // Thumbnail foto checkout ADDITIONAL
  photoPulangUrl            String?      // Fallback kompatibilitas foto pulang umum
  photoTumbangUrl           String?      // Link URL foto surat sakit / bukti klinik P3K
  tumbangNotes              String?      // Rincian penyebab tumbang (misal: kram otot di dock 4)
  
  // Hasil Audit Integritas (Deteksi Pekerja Kabur)
  selisihRegular            Int          @default(0)     // Selisih kabur regular: actualRegular - (pulangReg + tumbangReg)
  selisihAdditional         Int          @default(0)     // Selisih kabur additional: actualAdd - (pulangAdd + tumbangAdd)
  selisihCount              Int          @default(0)     // Total selisih orang kabur
  isBalanced                Boolean      @default(true)  // True jika selisihCount == 0 (seimbang/klop)
  createdAt                 DateTime     @default(now())
}

// ----------------------------------------------------------------------------
// 6. MODEL UNDER ASSIGNMENT (Distribusi Pos & Under Lapangan J&T)
// Karyawan / Leader Lapangan J&T ("Under") yang memegang anak-anak Reg & Add
// di masing-masing divisi (Bongkar, Muat, Sortir 3 Jalur, FIFO, Repack)
// tanpa memedulikan asal vendor.
// ----------------------------------------------------------------------------
model UnderAssignment {
  id              String   @id @default(cuid())
  date            String   // Tanggal kerja format YYYY-MM-DD
  shiftId         String
  shift           Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  division        String   // BONGKARAN, MUATAN, SORTIR_BODEBEK, SORTIR_SUMATRAAN, SORTIR_JAKARTA, FIFO, REPACK
  underName       String   // Nama Under / Leader JNT (misal: "Under Budi", "Under 1")
  regularCount    Int      @default(0) // Jumlah anak Regular yang dipegang
  additionalCount Int      @default(0) // Jumlah anak Additional yang dipegang
  totalHeadcount  Int      // regularCount + additionalCount
  photoUrl        String?  // Foto bukti regu bersama Under
  notes           String?  // Catatan lapangan
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date, shiftId])
}