# dependencies
# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
# Testing
/coverage

# next.js
# Next.js
/.next/
/out/

# production
# Production
/build

# misc
# Misc
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts

# debug
# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
prisma_log.txt

# env files (can opt-in for committing if needed)
.env*
# Environment files
.env
.env.local
.env.production

# vercel
# Database SQLite local
*.db
*.db-journal

# Uploaded media (keep folder via .gitkeep)
/public/uploads/*
!/public/uploads/.gitkeep

# Vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
